# Voice Assistant (bundled inside PrepMate) — copy to .env and fill in what you have.
# The voice agent also answers course questions from PrepMate's /ask API. No key is
# needed for that tool; it only needs the PrepMate backend running on port 8000.

# Gemini Live gives the lowest latency. Leave blank to use the local Ollama +
# faster-whisper + Piper fallback (works offline once the models are downloaded).
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_VOICE=Puck
GEMINI_LANGUAGE=en-US

# Seconds of user silence before one idle prompt, then before goodbye/end.
IDLE_PROMPT_SECONDS=15
IDLE_END_SECONDS=10

# Local service. 45123 is the original standalone app; 45124 avoids collisions.
HOST=127.0.0.1
PORT=45124

# Tools. Keys stay on the backend and are never sent to the browser.
TAVILY_API_KEY=
# Optional fallback used only when a Tavily call fails. Leave empty to disable.
BRAVE_API_KEY=

# PrepMate RAG backend used by the syllabus_search voice tool.
PREPMATE_API_BASE=http://127.0.0.1:8000

# Backend selection:
#   auto   - use Gemini Live when reachable, otherwise local models (recommended)
#   gemini - Gemini Live only; fail if unreachable
#   local  - always use local STT + LLM + TTS (Ollama, faster-whisper, Piper)
VOICE_BACKEND=auto

# Offline local models. Pull the chat model and download the STT/TTS assets once.
#   ollama pull qwen2.5:3b-instruct
# See SETUP.md for Whisper and Piper download commands.
# A local CTranslate2 model directory also works (the bundled copy is in .cache/whisper/small.en).
LOCAL_STT_MODEL=small.en
LOCAL_STT_NUM_THREADS=2
LOCAL_LLM_MODEL=qwen2.5:3b-instruct
LOCAL_LLM_TEMPERATURE=0.7
LOCAL_TTS_VOICE=en_US-lessac-medium
# Directory holding Piper voices (default: ~/.cache/piper)
PIPER_MODELS_DIR=

# Local persistence and embeddings (all optional; defaults shown).
# Relative paths resolve against the VoiceAssistant/ folder.
VOICE_DB_PATH=data/voice_assistant.duckdb
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBEDDING_DIM=768
OLLAMA_TIMEOUT_SECONDS=10

# Post-call memory distillation. Requires GEMINI_API_KEY; local fallback when absent.
MEMORY_MODEL=gemini-flash-lite-latest
MEMORY_EXTRACTION_TIMEOUT_SECONDS=15
MEMORY_DEDUPE_THRESHOLD=0.93
MEMORY_CONTEXT_LIMIT=20
CONTEXT_TURN_LIMIT=20

# Caching / cold-start tuning.
CONTEXT_CACHE_TTL_SECONDS=300
EMBEDDING_CACHE_MAX_ENTRIES=512
EMBEDDING_CACHE_TTL_SECONDS=3600
NETWORK_WAIT_SECONDS=10

# OpenCode bridge (optional; uses the already-running service, starts no new agent).
OPENCODE_BASE_URL=http://127.0.0.1:28894
OPENCODE_SERVICE_PASSWORD=
# Both paths are relative to the PrepMate workspace; worktrees stay OUTSIDE VoiceAssistant/.
OPENCODE_PROJECT_DIR=D:\GEN_AI\PrepMate\VoiceAssistant
OPENCODE_WORKTREE_ROOT=D:\GEN_AI\PrepMate\VoiceAssistant-worktrees
OPENCODE_TASK_WAIT_SECONDS=45
OPENCODE_TASK_TIMEOUT_SECONDS=300
OPENCODE_APPROVAL_TIMEOUT_SECONDS=60

# Coding model chain for the voice code_task tool (automatic fallback).
NVIDIA_API_KEY=
VOICE_CODE_MODEL_PRIMARY=nvidia/minimaxai/minimax-m3.1-flash
VOICE_CODE_MODEL_SECONDARY=nvidia/nemotron-3.5-lightning-30b-a3b
VOICE_CODE_MODEL_FALLBACK=ollama/qwen2.5:3b-instruct
