# Copy this file to .env and adjust values for your environment.

# Where the Ollama API lives (default is localhost).
OLLAMA_HOST=http://localhost:11434

# Embedding model used to vectorize chunks and queries.
# Pull it first:  ollama pull nomic-embed-text
OLLAMA_EMBED_MODEL=nomic-embed-text

# Chat/generation model used to answer questions.
# Pull it first:  ollama pull qwen2.5:3b-instruct
OLLAMA_LLM_MODEL=qwen2.5:3b-instruct

# How many retrieved chunks to pass into the prompt as context.
RETRIEVE_K=5

# Rewrite fragments/typos ("what hypernymy") into a clean question before
# retrieval. Costs one short extra LLM call per question; set false to disable.
QUERY_REWRITE=true

# Slides are tiny, so definitions and examples often sit on adjacent pages. For
# the top NEIGHBOR_TOP_N hits, also give the LLM NEIGHBOR_PAGES pages on each
# side as extra context (not cited, not distance-gated). 0 disables.
NEIGHBOR_PAGES=1
NEIGHBOR_TOP_N=2

# Relevance gate on DuckDB's cosine distance (lower = more similar).
# Retrieved chunks closer than MAX_DISTANCE are kept; chunks further away are
# discarded before the LLM is called. On this corpus answerable top-hits are
# ~0.17-0.34 and out-of-scope top-hits are ~0.48-0.59.
MAX_DISTANCE=0.40

# Shared DuckDB + HNSW course database. Voice answers use this same index via
# the backend /ask endpoint; the voice process never reads course files.
COURSE_DB_PATH=vectorstore/course.duckdb
EMBEDDING_DIM=768

# Where the syllabus/course PDFs are read from.
PDF_DIR=data/pdfs

# Maximum size (MB) allowed for a single uploaded document via /ingest/upload.
MAX_UPLOAD_MB=50
