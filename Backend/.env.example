# Copy this file to .env and adjust values for your environment.

# Where the Ollama API lives (default is localhost).
OLLAMA_HOST=http://localhost:11434

# Embedding model used to vectorize chunks and queries.
# Pull it first:  ollama pull nomic-embed-text
OLLAMA_EMBED_MODEL=nomic-embed-text

# Chat/generation model used to answer questions.
# Pull it first:  ollama pull llama3.2
OLLAMA_LLM_MODEL=llama3.2

# How many retrieved chunks to pass into the prompt as context.
RETRIEVE_K=4

# Relevance gate. Chroma's score is an L2 distance (lower = more similar).
# Retrieved chunks closer than MAX_DISTANCE are kept; chunks further away are
# discarded before the LLM is called. Calibrated on this corpus: answerable
# top-hits are ~0.2-0.5, unanswerable ~0.8-1.2, so 0.70 separates them cleanly.
MAX_DISTANCE=0.70

# Where the persisted Chroma DB lives.
VECTORSTORE_DIR=vectorstore/chroma

# Where the syllabus/course PDFs are read from.
PDF_DIR=data/pdfs

# Maximum size (MB) allowed for a single uploaded document via /ingest/upload.
MAX_UPLOAD_MB=50
